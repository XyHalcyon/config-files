{
  "plugin": ["oh-my-openagent"],
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "provider": {
    "codiz": {
      "npm": "@ai-sdk/anthropic",
      "name": "Codiz",
      "options": {
        "baseURL": "https://codiz.dev/v1",
        "apiKey": "xxx"
      },
      "models": {
      "claude-opus-4-8": {
          "name": "claude-opus-4-8"
        },
        "claude-opus-4-8-thinking": {
          "name": "claude-opus-4-8-thinking"
        }
      }
    },
    "bailian-payg": {
      "npm": "@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio",
      "options": {
        "apiKey": "xxx",
        "baseURL": "https://dashscope.aliyuncs.com/apps/anthropic/v1"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "options": {
            "thinking": {
              "budgetTokens": 8192,
              "type": "enabled"
            }
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "budgetTokens": 8192,
              "type": "enabled"
            }
          }
        }
      }
    },
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Gateway",
      "options": {
        "baseURL": "https://st8tp3ajl0df3n8b8l8qu.apigateway-cn-beijing.volceapi.com/v1",
        "apiKey": "xxx"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "doubao-seed-2.1-pro": {
          "name": "Doubao Seed 2.1 Pro"
        },
        "glm-5.2": {
          "name": "GLM 5.2"
        },
        "qwen3.7-max": {
          "name": "Qwen3.7-Max"
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7-Plus"
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3"
        },
        "hy3": {
          "name": "Hy3"
        }
      }
    }
  }
}
